# Credentials: only in the repo-root .env (template: .env.example). Never commit them.
.env
.env.*
!.env.example

# Firebase client configs (GoogleService-Info.plist / google-services.json) are committed on purpose:
# they belong to the sample's own Firebase app and Firebase client keys are not secrets.

# OS / editors
.DS_Store
.idea/
*.iml
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/tasks.json
**/.claude/settings.local.json
*.log

# Xcode / SwiftPM / CocoaPods
xcuserdata/
DerivedData/
build/
.build/
.swiftpm/
Pods/
*.xcuserstate
*.ipa
*.dSYM
*.dSYM.zip

# Gradle / Android Studio / Kotlin
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
local.properties
*.apk
*.aab
*.hprof
*.jks
*.keystore
key.properties

# Node / Vite / Ionic (dist/ and the native public/ copies embed the .env credentials)
node_modules/
dist/
.vite/
coverage/
.eslintcache

# Capacitor: files regenerated by `npx cap sync`
**/ios/App/App/public/
**/ios/App/App/capacitor.config.json
**/ios/App/App/config.xml
**/android/app/src/main/assets/public/
**/android/app/src/main/assets/capacitor.config.json
**/android/app/src/main/assets/capacitor.plugins.json
**/android/app/src/main/res/xml/config.xml
capacitor-cordova-android-plugins/
capacitor-cordova-ios-plugins/

# Flutter: files regenerated by `flutter pub get` / `flutter build`
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
GeneratedPluginRegistrant.*
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
